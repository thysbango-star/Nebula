{
  "name": "nebula-desktop",
  "productName": "Nebula",
  "version": "0.18.2",
  "description": "Nebula for Windows: Vibrance island, screen glow and a voice assistant.",
  "author": {
    "name": "Nebula",
    "email": "nebula@users.noreply.github.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/brain.js && node --check src/voice.js && node --check src/preload.js && node --check src/win32.js && node --check src/agent.js && node --check src/store.js && node --check src/docs.js && node --check src/ears.js && node --check src/sports.js && node --check src/covers.js && node --check src/linux.js && node --check src/support.js && node --check src/beam.js && node --check src/interrupt.js && node --check src/widgets.js && node --check src/moodplay.js",
    "dist": "electron-builder --win nsis portable --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --x64 --publish never"
  },
  "dependencies": {
    "sherpa-onnx-node": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.nebula.desktop",
    "productName": "Nebula",
    "copyright": "Nebula",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "models/kws",
        "to": "kws"
      },
      {
        "from": "../shared/moodplay",
        "to": "moodplay"
      }
    ],
    "asarUnpack": [
      "node_modules/sherpa-onnx*/**"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Nebula-Setup.${ext}",
      "shortcutName": "Nebula"
    },
    "portable": {
      "artifactName": "Nebula-Portable.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ],
      "synopsis": "Nebula \u2014 your voice-first assistant",
      "maintainer": "Nebula <nebula@users.noreply.github.com>"
    },
    "appImage": {
      "artifactName": "Nebula-Linux.${ext}"
    },
    "deb": {
      "artifactName": "Nebula-Linux.${ext}",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "playerctl"
      ]
    }
  },
  "homepage": "https://github.com/thysbango-star/Nebula"
}

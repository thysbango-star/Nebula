<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="@null"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
        <ImageView android:id="@+id/w_art" android:layout_width="76dp" android:layout_height="76dp" android:scaleType="centerCrop" android:contentDescription="Album art"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:layout_marginStart="12dp" android:gravity="center_vertical">
            <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="Nothing playing"/>
            <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
            <ImageView android:id="@+id/w_bars" android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="4dp" android:scaleType="fitStart" android:contentDescription="@null"/>
            <ProgressBar android:id="@+id/w_progress" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="4dp" android:max="1000" android:progressDrawable="@drawable/w_progress"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
                <ImageView android:id="@+id/w_prev" android:layout_width="34dp" android:layout_height="34dp" android:padding="6dp" android:src="@drawable/ic_w_prev" android:tint="#FFFFFF" android:contentDescription="Previous"/>
                <FrameLayout android:id="@+id/w_play" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:background="@drawable/w_disc_white">
                    <ImageView android:id="@+id/w_play_icon" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_w_play_dark" android:contentDescription="Play or pause"/>
                </FrameLayout>
                <ImageView android:id="@+id/w_next" android:layout_width="34dp" android:layout_height="34dp" android:padding="6dp" android:src="@drawable/ic_w_next" android:tint="#FFFFFF" android:contentDescription="Next"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

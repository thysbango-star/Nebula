<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talking to the AI brain (Groq) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Rovian Intelligence: calendar (asked only when you connect it), and re-planning reminders after a restart -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Nebula Beam: find nearby Nebula devices on the same Wi-Fi (mDNS) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Beam Link's hotspot mode: Android's temporary "local-only" hotspot, for when the other device isn't on your Wi-Fi -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />
    <!-- Hearing "Hey Nebula" and your questions -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- live audio bars on the music card (android.media.audiofx.Visualizer) -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Keeping the wake word listener alive in the background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets Nebula pop up over other apps when you say the wake word -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Stops One UI from killing the listener -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Small extras: wake haptic, timers -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Messaging: find contacts and send texts you approve -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Calls you approve, and answer/decline from the Notch -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <!-- Optional: set Nebula's ringtone as the default -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <queries>
        <!-- Speech-to-text and text-to-speech engines -->
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <!-- Opening your files in Office/Docs and links in the browser -->
        <intent><action android:name="android.intent.action.VIEW" /><data android:mimeType="*/*" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <!-- "Open Spotify" etc. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NebulaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nebula">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Nebula.App"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The glass panel that slides up over whatever you're doing. -->
        <activity
            android:name=".ui.AssistantActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.nebula.assistant.panel"
            android:theme="@style/Theme.Nebula.Panel" />

        <!-- Invisible: lets the Notch start a voice chat from inside any app. -->
        <activity
            android:name=".ui.TalkActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="com.nebula.assistant.talk"
            android:theme="@style/Theme.Nebula.Invisible" />

        <!-- Rovian Intelligence: home-screen widgets -->
        <receiver android:name=".widgets.VoiceWidget" android:exported="true" android:label="@string/app_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_voice" />
        </receiver>
        <receiver android:name=".widgets.MusicWidget" android:exported="true" android:label="@string/app_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_music" />
        </receiver>
        <receiver android:name=".widgets.AskWidget" android:exported="true" android:label="@string/app_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_ask" />
        </receiver>
        <receiver android:name=".widgets.TasksWidget" android:exported="true" android:label="@string/app_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_tasks" />
        </receiver>
        <receiver android:name=".widgets.SportsWidget" android:exported="true" android:label="@string/app_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_sports" />
        </receiver>
        <receiver android:name=".widgets.DailyWidget" android:exported="true" android:label="@string/app_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_daily" />
        </receiver>
        <receiver android:name=".widgets.WidgetReceiver" android:exported="false" />
        <activity
            android:name=".widgets.AskActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.nebula.assistant.ask"
            android:windowSoftInputMode="adjustResize|stateVisible"
            android:theme="@style/Theme.Nebula.Invisible" />

        <!-- Rovian Intelligence: event reminders, briefings and reminders (re-planned after boot / clock changes) -->
        <receiver android:name=".intel.IntelReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Nebula Beam: choose what to send (system photo/file pickers) -->
        <activity
            android:name=".beam.BeamActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.nebula.assistant.beam"
            android:theme="@style/Theme.Nebula.Invisible" />

        <!-- Quick Settings tile: Beam -->
        <service
            android:name=".beam.BeamTile"
            android:exported="true"
            android:icon="@drawable/ic_stat_nebula"
            android:label="Beam"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>

        <service
            android:name=".wake.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Screen control + the Nebula Notch -->
        <service
            android:name=".device.NebulaAccessibility"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_config" />
        </service>

        <!-- Music, messages and calls for the Notch -->
        <service
            android:name=".notch.NebulaNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>

        <!-- Opening and sharing files Nebula creates -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
